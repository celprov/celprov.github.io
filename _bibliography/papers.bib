	booktitle = {29th Annual Meeting of the Organization for Human Brain Mapping (OHBM) in Montreal},
	abbr = {OHBM},
	file = {Full Text PDF:/Users/cprovins/Zotero/storage/7SNKPLTH/Provins et al. - 2023 - Assessment of B1 field dynamics of rats BOLD fMRI .pdf:application/pdf},
